; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Syntax Slayer"
run/main_scene="uid://datpl4xwi7mn5"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=2
boot_splash/image="uid://c6nvn425u52ye"

[autoload]

SpawnManager="*uid://boqw0or52j362"
Global="*uid://c84ai0hunqw0b"
VideoManager="*uid://b61hsf0rxodqg"
Gameprogress="*uid://cgd4hpg1iuvqx"
Hud="*uid://d3ahh2ldlvvqi"
FadeTransition="*uid://blv81h306rl51"
Database="*uid://c4e6eae7b3cjb"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotAndroidPluginTemplate/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg")

